    ORC --> NORM["Product Normalization"]
    ORC --> OPT["Basket Optimizer"]
    ORC --> BR["Browser Executor"]
    ORC --> PAY["Payment Orchestrator"]
    ORC --> ORD["Order Manager"]

    REG --> A1["MockMarketplace: mock-bazaar"]
    REG --> A2["MockMarketplace: mock-fresh"]
