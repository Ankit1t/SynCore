    PAY --> PP["PaymentProvider (mock / real)"]
    ORC --> BUS["Event Bus"]
    ORC --> DB[("PostgreSQL / SQLite")]
    BUS --> AUD["Audit Log"]
    ORC --> LLM["LLM Provider (deterministic / OpenAI)"]

    subgraph Deterministic core
