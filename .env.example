# =============================================================================
# Syncore configuration (copy to .env and adjust). Never commit real secrets.
# Every value below has a safe default in src/syncore/config.py, so the app runs
# with an empty .env.
# =============================================================================

# --- General ---
ENVIRONMENT=local              # local | staging | production
LOG_LEVEL=INFO
LOG_JSON=false

# --- Persistence ---
# SQLite (zero setup) by default. For Postgres (docker-compose profile):
# DATABASE_URL=postgresql+psycopg://syncore:syncore@localhost:5432/syncore
DATABASE_URL=sqlite:///./syncore.db

# --- Cache / events (optional; in-memory fallback if unset) ---
# REDIS_URL=redis://localhost:6379/0

# --- LLM ---
# "deterministic" = built-in, offline, no key (grocery-only).
# For ANY item, use a real LLM. Set LLM_PROVIDER + LLM_API_KEY (+ optional MODEL).
# Pick one:
#   groq      FREE, fast      key: https://console.groq.com/keys      model e.g. llama-3.3-70b-versatile
#   gemini    FREE tier       key: https://aistudio.google.com/apikey (uses native Gemini API)
#   zai       FREE model      key: https://z.ai/manage-apikey/apikey-list   model: glm-4.5-flash
#   openrouter FREE models    key: https://openrouter.ai/keys         model e.g. meta-llama/llama-3.1-8b-instruct:free
#   ollama    FREE, local     no key   (`ollama pull llama3.2`)       LLM_PROVIDER=ollama
#   deepseek  cheap (paid)    key: https://platform.deepseek.com      model: deepseek-chat
#   openai    paid            key: https://platform.openai.com        model: gpt-4o-mini
# Any OTHER OpenAI-compatible provider: set a custom LLM_BASE_URL + LLM_MODEL + LLM_API_KEY.
LLM_PROVIDER=deterministic     # deterministic | groq | gemini | zai | openrouter | ollama | deepseek | openai | <custom>
LLM_MODEL=                     # empty = provider default
LLM_API_KEY=                   # required for all cloud providers except ollama
LLM_BASE_URL=                  # only for a custom provider (or to override a preset)
MAX_AGENT_STEPS=50
MAX_AGENT_RUNTIME_SECONDS=120

# --- Marketplace ---
MARKETPLACE_MODE=mock          # mock | live
DEFAULT_MARKETPLACE=mock-bazaar

# --- Browser ---
BROWSER_MODE=mock              # mock | playwright

# --- Money / budget ---
DEFAULT_CURRENCY=INR
DEFAULT_BUDGET=500

# --- Payments ---
# mock     = deterministic sandbox, settles instantly (no real money, no keys).
# razorpay = live Razorpay TEST mode. The agentic checkout ("one door") creates a
#            REAL test-mode order and the user authorizes it via hosted UPI/card
#            checkout. Requires the two keys below (test keys: rzp_test_...).
PAYMENT_PROVIDER=mock          # mock | razorpay | stripe
RAZORPAY_KEY_ID=               # rzp_test_XXXX — your test key id from the Razorpay dashboard
RAZORPAY_KEY_SECRET=           # matching test key secret (never commit real values)
WEBHOOK_SECRET=dev-webhook-secret-change-me   # HMAC secret for payment webhooks
PAYMENT_AUTO_LIMIT=500         # auto-execute only at/under this amount for trusted vendors
PAYMENT_DAILY_LIMIT=5000

# --- Optimizer ---
DEFAULT_OBJECTIVE=BEST_VALUE   # CHEAPEST | BEST_VALUE | FASTEST | BEST_QUALITY | BALANCED
DEFAULT_MIN_RATING=3.5

# --- Scraping robustness ---
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_RATE_LIMIT_PER_MIN=60

# --- Feature flags (risky features default OFF) ---
FEATURE_AUTOMATIC_PAYMENT=true
FEATURE_BROWSER_EXECUTION=true
FEATURE_MULTI_MARKETPLACE=true
FEATURE_AUTO_SUBSTITUTION=false

# --- Ranking weights (must sum ~1.0; normalized at load) ---
RANK_SEMANTIC=0.30
RANK_LEXICAL=0.20
RANK_QUANTITY=0.15
RANK_CATEGORY=0.15
RANK_BRAND=0.10
RANK_QUALITY=0.10

# GEMINI_API_KEY="your-gemini-api-key"
# OpenAI_API_KEY="sk-your-openai-api-key"
# HUGGINGFACEHUB_API_TOKEN="hf_your-huggingface-token"

